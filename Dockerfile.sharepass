# Stage 1: Build front-end assets
FROM node:25-alpine AS builder
WORKDIR /build

# Copy npm configuration and package files
COPY .npmrc package.json package-lock.json ./

# Run npm audit before installing to check for vulnerabilities
# This checks the package-lock.json for known vulnerabilities
# Fail the build if high or higher vulnerabilities are found
RUN npm audit --audit-level=high || \
    (echo "ERROR: npm audit found vulnerabilities at high level or higher." && \
     echo "Please review and fix vulnerabilities before proceeding." && \
     npm audit --audit-level=high && exit 1)

# Install dependencies using npm ci for reproducible builds
# Install scripts are disabled by default via .npmrc (ignore-scripts=true)
# npm ci respects .npmrc settings automatically
RUN npm ci

# Copy only the files needed to build front-end assets
COPY highlight-setup.js webpack.config.js ./

# Build highlight bundle (outputs to app/static/js/). Icons are an inline SVG sprite and
# fonts are self-hosted in app/static, so nothing else is copied from node_modules.
RUN npm run build-highlight

# Stage 2: Final production image
FROM python:3.14-slim
WORKDIR /app

# Create a non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install Python dependencies first (separate layer for better caching).
# pip itself is removed afterwards: it is not needed at runtime and its vendored
# libraries would otherwise show up in vulnerability scans of the image.
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt && \
    pip uninstall -y pip

# Copy application code and VERSION file from the host
COPY ./app ./
COPY VERSION ./

# Overlay only the built front-end assets from the builder stage
# This brings in the webpack bundle — NOT node_modules
COPY --from=builder /build/app/static/js/ ./static/js/

# Application code stays owned by root so the app user cannot modify it at runtime.
# Only the database directory (IP hash salt and SQLite file) is writable by appuser. It is
# recreated empty here so a database from the build context can never end up in the image.
RUN rm -rf ./database && mkdir ./database && \
    chown appuser:appuser ./database

# Switch to non-root user
USER appuser

EXPOSE 8080
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Healthcheck: /healthz answers 204 without rendering a page and is excluded from the access log
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/healthz')" || exit 1

CMD ["python", "app.py"]
