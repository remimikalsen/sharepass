# Stage 1: Build front-end assets
FROM node:25-alpine AS builder
WORKDIR /build

# Copy npm configuration and package files
COPY .npmrc package.json package-lock.json ./

# Run npm audit before installing to check for vulnerabilities
# This checks the package-lock.json for known vulnerabilities
# Fail the build if high or higher vulnerabilities are found
RUN npm audit --audit-level=high || \
    (echo "ERROR: npm audit found vulnerabilities at high level or higher." && \
     echo "Please review and fix vulnerabilities before proceeding." && \
     npm audit --audit-level=high && exit 1)

# Install dependencies using npm ci for reproducible builds
# Install scripts are disabled by default via .npmrc (ignore-scripts=true)
# npm ci respects .npmrc settings automatically
RUN npm ci

# Copy only the files needed to build front-end assets
COPY highlight-setup.js webpack.config.js ./

# Build highlight bundle (outputs to app/static/js/)
RUN npm run build-highlight

# Copy vendor assets from node_modules to app/static/
# Uses shell commands instead of 'npm run copy-assets' (which uses shx/shelljs/execa)
# to avoid pulling the execa transitive dependency into the build layer
RUN mkdir -p app/static/js app/static/css && \
    cp node_modules/feather-icons/dist/feather.min.js app/static/js/feather.min.js && \
    cp node_modules/highlight.js/styles/default.min.css app/static/css/highlight.default.min.css

# Stage 2: Final production image
FROM python:3.14-slim
WORKDIR /app

# Create a non-root user for security
RUN groupadd -r appuser && useradd -r -g appuser appuser

# Install Python dependencies first (separate layer for better caching)
COPY requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy application code and VERSION file from the host
COPY ./app ./
COPY VERSION ./

# Overlay only the built front-end assets from the builder stage
# This brings in the webpack bundle and vendor files — NOT node_modules
COPY --from=builder /build/app/static/ ./static/

# Create database directory and set ownership
RUN mkdir -p ./database && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

EXPOSE 8080
ENV PYTHONUNBUFFERED=1

# Healthcheck to verify the application is running
# Uses Python's built-in urllib to check if the app responds
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/')" || exit 1

CMD ["python", "app.py"]
